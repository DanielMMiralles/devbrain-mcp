# DevBrain MCP Environment Configuration
# Set absolute paths to your local Obsidian Vault and Projects directory

# Windows paths example:
# VAULT_PATH=C:/Users/tu_usuario/Documents/Obsidian Vault
# PROJECTS_PATH=C:/Users/tu_usuario/Desktop

# Linux / macOS paths example:
# VAULT_PATH=/home/usuario/Documents/ObsidianVault
# PROJECTS_PATH=/home/usuario/Developer

VAULT_PATH=./starter-vault
PROJECTS_PATH=./projects
